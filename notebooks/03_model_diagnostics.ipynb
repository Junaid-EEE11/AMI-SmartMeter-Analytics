   "source": [
    "# 03 - Conformal Model Diagnostics & Sequential Calibration\n",
    "\n",
    "**Project:** Trustworthy AMI Forecasting Under Behavioral Distribution Shift (`shift-ami`)  \n",
    "**Objective:** Analyze sequential adaptive conformal trajectories, dynamic rate adaptation ($\gamma_t$), adaptive alpha ($\alpha_t$), and prediction interval coverage under distribution shift."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "# Load saved sequential test trajectories\n",
    "results_dir = Path(\"../results/smoke\")\n",
    "df_traj = pd.read_parquet(results_dir / \"sequential_trajectories.parquet\")\n",
    "print(f\"Loaded trajectory dataset with {len(df_traj):,} rows.\")\n",
    "df_traj.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Trace Adaptive Alpha (\\$\\alpha_t\\$) & Shift Flag"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(12, 6))\n",
    "plt.subplot(2, 1, 1)\n",
    "plt.plot(df_traj['timestamp'], df_traj['sa_acp_alpha_t'], label='SA-ACP Adaptive Alpha ($\\alpha_t$)', color='#d62728', lw=1.5)\n",
    "plt.axhline(0.10, color='black', linestyle='--', label='Nominal Alpha (0.10)')\n",
    "plt.ylabel('Adaptive Alpha')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "\n",
    "plt.subplot(2, 1, 2)\n",
    "plt.plot(df_traj['timestamp'], df_traj['sa_acp_shift_score'], label='SA-ACP 1D Wasserstein Shift Score', color='#1f77b4', lw=1.5)\n",
    "plt.axhline(1.5, color='orange', linestyle='--', label='Shift Detection Threshold ($\\theta=1.5$)')\n",
    "plt.xlabel('Evaluation Timeline')\n",
    "plt.ylabel('Shift Score')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
